generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALES_USER
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  role         UserRole @default(SALES_USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enquiries Enquiry[]
}

model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  companyName   String   @db.VarChar(180)
  contactPerson String   @db.VarChar(120)
  mobile        String   @db.VarChar(25)
  email         String   @db.VarChar(255)
  city          String   @db.VarChar(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enquiries Enquiry[]
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(30)
  name      String   @db.VarChar(150)
  category  String   @db.VarChar(100)
  unit      String   @db.VarChar(20)
  basePrice Decimal  @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory      Inventory?
  enquiryItems   EnquiryItem[]
  quotationItems QuotationItem[]
  orderItems     SalesOrderItem[]
  dispatchItems  DispatchItem[]
}

model Inventory {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @unique @db.Uuid
  physicalQuantity Int      @default(0)
  reservedQuantity Int      @default(0)
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("inventory")
}

model Enquiry {
  id           String        @id @default(uuid()) @db.Uuid
  enquiryNumber String       @unique @db.VarChar(30)
  customerId   String        @db.Uuid
  createdById  String        @db.Uuid
  enquiryDate  DateTime      @default(now())
  requiredDate DateTime?
  notes        String?       @db.Text
  status       EnquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items       EnquiryItem[]
  quotations  Quotation[]

  @@index([customerId])
  @@index([status])
}

model EnquiryItem {
  id        String @id @default(uuid()) @db.Uuid
  enquiryId String @db.Uuid
  productId String @db.Uuid
  quantity  Int

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([enquiryId, productId])
}

model Quotation {
  id              String          @id @default(uuid()) @db.Uuid
  quotationNumber String          @unique @db.VarChar(30)
  enquiryId       String          @db.Uuid
  validUntil      DateTime
  status          QuotationStatus @default(DRAFT)
  subtotal        Decimal         @db.Decimal(14, 2)
  totalDiscount   Decimal         @db.Decimal(14, 2)
  totalGst        Decimal         @db.Decimal(14, 2)
  grandTotal      Decimal         @db.Decimal(14, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  enquiry Enquiry          @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  items   QuotationItem[]
  order   SalesOrder?

  @@index([enquiryId])
  @@index([status])
}

model QuotationItem {
  id          String  @id @default(uuid()) @db.Uuid
  quotationId String  @db.Uuid
  productId   String  @db.Uuid
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  gstPct      Decimal @default(18) @db.Decimal(5, 2)
  lineAmount  Decimal @db.Decimal(14, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([quotationId, productId])
}

model SalesOrder {
  id            String           @id @default(uuid()) @db.Uuid
  orderNumber   String           @unique @db.VarChar(30)
  quotationId   String           @unique @db.Uuid
  orderDate     DateTime         @default(now())
  totalAmount   Decimal          @db.Decimal(14, 2)
  status        SalesOrderStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  quotation Quotation       @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  items     SalesOrderItem[]
  dispatches Dispatch[]

  @@index([status])
}

model SalesOrderItem {
  id           String @id @default(uuid()) @db.Uuid
  salesOrderId String @db.Uuid
  productId    String @db.Uuid
  quantity     Int
  dispatchedQuantity Int @default(0)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([salesOrderId, productId])
}

model Dispatch {
  id             String   @id @default(uuid()) @db.Uuid
  dispatchNumber String   @unique @db.VarChar(30)
  salesOrderId   String   @db.Uuid
  dispatchDate   DateTime @default(now())
  vehicleNumber  String   @db.VarChar(30)
  driverName     String   @db.VarChar(120)
  createdAt      DateTime @default(now())

  salesOrder SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  items      DispatchItem[]

  @@index([salesOrderId])
}

model DispatchItem {
  id         String @id @default(uuid()) @db.Uuid
  dispatchId String @db.Uuid
  productId  String @db.Uuid
  quantity   Int

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([dispatchId, productId])
}